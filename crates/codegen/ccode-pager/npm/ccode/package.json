    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@iarna/toml": "^3.0.0"
    },
    "optionalDependencies": {
        "@ccode-official/ccode-darwin-arm64": "0.1.220-alpha.4",
        "@ccode-official/ccode-darwin-x64": "0.1.220-alpha.4",
        "@ccode-official/ccode-linux-arm64": "0.1.220-alpha.4",
        "@ccode-official/ccode-linux-x64": "0.1.220-alpha.4",
        "@ccode-official/ccode-win32-arm64": "0.1.220-alpha.4",
        "@ccode-official/ccode-win32-x64": "0.1.220-alpha.4"
    }
